{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ima Langnubi Dairy",
  "version": "1.0.0",
  "identifier": "com.imalangnubi.dairy",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Ima Langnubi Dairy — Farm Manager",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../backend"]
  }
}
